  "compilerOptions": {
    "target": "ES2022", "lib": ["ES2022", "DOM"], "module": "NodeNext",
    "moduleResolution": "NodeNext", "outDir": "dist-electron", "rootDir": ".",
    "strict": true, "skipLibCheck": true, "esModuleInterop": true,
    "resolveJsonModule": true, "sourceMap": true
  },
  "include": ["electron", "shared"]
